{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pasc/core": ["packages/core/src/index.ts"],
      "@pasc/core/*": ["packages/core/src/*"],
      "@pasc/napcat": ["packages/napcat/src/index.ts"],
      "@pasc/agent": ["packages/agent/src/index.ts"],
      "@pasc/server": ["packages/server/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["**/node_modules", "**/data"]
}
